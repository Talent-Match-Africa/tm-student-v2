{
  "name": "Talent Match Student App",
  "version": "2.0.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": "20.20.x",
    "npm": "10.8.x"
  },
  "scripts": {
    "dev": "next dev -p 4002",
    "lockfile:validate": "node scripts/validate-linux-package-lock.mjs",
    "postinstall": "npm run lockfile:validate",
    "prebuild": "npm run lockfile:validate",
    "build": "next build --webpack",
    "start": "next start -p 4002",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci:check": "npm run lockfile:validate && npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource/outfit": "^5.2.8",
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "@radix-ui/react-dialog": "^1.1.18",
    "clsx": "^2.1.1",
    "libphonenumber-js": "^1.13.7",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.10"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.24",
    "sharp": "0.35.3"
  }
}
